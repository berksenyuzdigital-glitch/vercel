{
  "name": "Dental 02 - 24 Saat Önce Hatırlatma",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "triggerAtHour": 9, "triggerAtMinute": 0 }] }
      },
      "id": "w2-cron",
      "name": "Her Gün 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-260, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "SHEET_ID", "value": "BURAYA_GOOGLE_SHEET_ID", "type": "string" },
            { "id": "a2", "name": "SHEET_ADI", "value": "Randevular", "type": "string" },
            { "id": "a3", "name": "PHONE_NUMBER_ID", "value": "BURAYA_WHATSAPP_PHONE_NUMBER_ID", "type": "string" },
            { "id": "a4", "name": "GRAPH_VERSION", "value": "v21.0", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "w2-ayarlar",
      "name": "Ayarlar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "={{ $json.SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "={{ $json.SHEET_ADI }}", "mode": "name" },
        "options": {}
      },
      "id": "w2-read",
      "name": "Randevuları Oku",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [180, 300]
    },
    {
      "parameters": {
        "jsCode": "// Yarin randevusu olan, henuz 24s hatirlatmasi gitmemis kayitlari secer.\nconst cfg = $('Ayarlar').first().json;\nconst yarin = $now.setZone('Europe/Istanbul').plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst aktifDurumlar = ['yeni', 'onaylı', 'onayli'];\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (String(r.Tarih || '').trim() !== yarin) continue;\n  if (!aktifDurumlar.includes(String(r.Durum || '').trim().toLowerCase())) continue;\n  if (String(r.Hatirlatma24 || '').trim() !== '') continue;\n  if (!/^90\\d{10}$/.test(String(r.Telefon || '').trim())) continue;\n\n  const tarihGosterim = yarin.split('-').reverse().join('.');\n  out.push({\n    json: {\n      ID: r.ID,\n      Ad: r.Ad,\n      Telefon: String(r.Telefon).trim(),\n      Tarih: r.Tarih,\n      Saat: r.Saat,\n      wa: {\n        messaging_product: 'whatsapp',\n        to: String(r.Telefon).trim(),\n        type: 'template',\n        template: {\n          name: 'dental_24h_hatirlatma',\n          language: { code: 'tr' },\n          components: [\n            {\n              type: 'body',\n              parameters: [\n                { type: 'text', text: r.Ad || 'Değerli hastamız' },\n                { type: 'text', text: tarihGosterim },\n                { type: 'text', text: r.Saat || '' }\n              ]\n            }\n          ]\n        }\n      }\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "w2-filtre",
      "name": "Yarınki Randevuları Seç",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Ayarlar').first().json.GRAPH_VERSION }}/{{ $('Ayarlar').first().json.PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.wa) }}",
        "options": { "batching": { "batch": { "batchSize": 10, "batchInterval": 1000 } } }
      },
      "id": "w2-wa",
      "name": "24s Hatırlatma Gönder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "={{ $('Ayarlar').first().json.SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "={{ $('Ayarlar').first().json.SHEET_ADI }}", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ID": "={{ $('Yarınki Randevuları Seç').item.json.ID }}",
            "Hatirlatma24": "={{ $now.setZone('Europe/Istanbul').toFormat('yyyy-MM-dd HH:mm') }}",
            "Guncelleme": "={{ $now.setZone('Europe/Istanbul').toFormat('yyyy-MM-dd HH:mm') }}"
          },
          "matchingColumns": ["ID"],
          "schema": []
        },
        "options": {}
      },
      "id": "w2-update",
      "name": "Hatırlatma İşaretle",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 300]
    }
  ],
  "connections": {
    "Her Gün 09:00": { "main": [[{ "node": "Ayarlar", "type": "main", "index": 0 }]] },
    "Ayarlar": { "main": [[{ "node": "Randevuları Oku", "type": "main", "index": 0 }]] },
    "Randevuları Oku": { "main": [[{ "node": "Yarınki Randevuları Seç", "type": "main", "index": 0 }]] },
    "Yarınki Randevuları Seç": { "main": [[{ "node": "24s Hatırlatma Gönder", "type": "main", "index": 0 }]] },
    "24s Hatırlatma Gönder": { "main": [[{ "node": "Hatırlatma İşaretle", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Istanbul", "saveManualExecutions": true },
  "pinData": {}
}
