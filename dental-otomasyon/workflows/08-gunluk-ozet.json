{
  "name": "Dental 08 - Günlük Klinik Özeti + Rapor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 19,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "w8-cron",
      "name": "Her Gün 19:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "SHEET_ID",
              "value": "BURAYA_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "SHEET_ADI",
              "value": "Randevular",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "RAPOR_SHEET_ADI",
              "value": "Rapor",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "PHONE_NUMBER_ID",
              "value": "BURAYA_WHATSAPP_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "GRAPH_VERSION",
              "value": "v21.0",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "KLINIK_TELEFON",
              "value": "BURAYA_KLINIK_WHATSAPP_NUMARASI",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w8-ayarlar",
      "name": "Ayarlar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $json.SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.SHEET_ADI }}",
          "mode": "name"
        },
        "options": {}
      },
      "id": "w8-read",
      "name": "Randevuları Oku",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Gunluk ozet + kliniğe kanit niteliginde rapor satiri.\nconst cfg = $('Ayarlar').first().json;\nfunction normalizeTel(raw) {\n  let t = String(raw || '').replace(/\\D/g, '');\n  if (t.startsWith('00')) t = t.slice(2);\n  if (t.startsWith('0')) t = t.slice(1);\n  if (t.length === 10) t = '90' + t;\n  return t;\n}\n\nconst simdi = $now.setZone('Europe/Istanbul');\nconst bugun = simdi.toFormat('yyyy-MM-dd');\nconst yarin = simdi.plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst d = (r) => String(r.Durum || '').trim().toLowerCase();\nconst t = (r) => String(r.Tarih || '').trim();\nconst rows = $input.all().map((i) => i.json);\n\nconst yarinToplam = rows.filter((r) => t(r) === yarin && ['yeni', 'onaylı', 'onayli'].includes(d(r))).length;\nconst yarinOnayli = rows.filter((r) => t(r) === yarin && ['onaylı', 'onayli'].includes(d(r))).length;\nconst yarinBekleyen = yarinToplam - yarinOnayli;\nconst bugunIptal = rows.filter((r) => t(r) === bugun && d(r) === 'iptal').length;\nconst beklemeKisi = rows.filter((r) => d(r) === 'bekleme').length;\n// Otomasyonun bugun icin doldurdugu koltuklar: teklif edilmis ve kabul edilmis olanlar.\nconst doldurulan = rows.filter((r) => String(r.TeklifTarih || '').trim() === bugun && t(r) === bugun && ['onaylı', 'onayli', 'geldi'].includes(d(r))).length;\n\nreturn [{\n  json: {\n    Tarih: bugun,\n    YarinToplam: yarinToplam,\n    YarinOnayli: yarinOnayli,\n    YarinBekleyen: yarinBekleyen,\n    BugunIptal: bugunIptal,\n    DoldurulanKoltuk: doldurulan,\n    BeklemeListesi: beklemeKisi,\n    wa: {\n      messaging_product: 'whatsapp',\n      to: normalizeTel(cfg.KLINIK_TELEFON),\n      type: 'template',\n      template: {\n        name: 'dental_gunluk_ozet',\n        language: { code: 'tr' },\n        components: [\n          {\n            type: 'body',\n            parameters: [\n              { type: 'text', text: bugun.split('-').reverse().join('.') },\n              { type: 'text', text: String(yarinToplam) },\n              { type: 'text', text: String(yarinOnayli) },\n              { type: 'text', text: String(yarinBekleyen) },\n              { type: 'text', text: String(bugunIptal) },\n              { type: 'text', text: String(doldurulan) },\n              { type: 'text', text: String(beklemeKisi) }\n            ]\n          }\n        ]\n      }\n    }\n  }\n}];"
      },
      "id": "w8-hesap",
      "name": "Günü Hesapla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Ayarlar').first().json.SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Ayarlar').first().json.RAPOR_SHEET_ADI }}",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Tarih": "={{ $json.Tarih }}",
            "YarinToplam": "={{ $json.YarinToplam }}",
            "YarinOnayli": "={{ $json.YarinOnayli }}",
            "YarinBekleyen": "={{ $json.YarinBekleyen }}",
            "BugunIptal": "={{ $json.BugunIptal }}",
            "DoldurulanKoltuk": "={{ $json.DoldurulanKoltuk }}",
            "BeklemeListesi": "={{ $json.BeklemeListesi }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "w8-rapor",
      "name": "Rapor Satırı Yaz",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Ayarlar').first().json.GRAPH_VERSION }}/{{ $('Ayarlar').first().json.PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Günü Hesapla').item.json.wa) }}",
        "options": {}
      },
      "id": "w8-wa",
      "name": "Kliniğe Özet Gönder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
